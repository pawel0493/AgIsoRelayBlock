+TEST_F(VirtualTerminalTest, PreferredAuxAssignmentsStoreRemoveAndNonPreferredNoOp)
+{
+	NAME clientNAME(0);
+	auto internalECU = CANNetworkManager::CANNetwork.create_internal_control_function(clientNAME, 0, 0x26);
+
+	std::vector<isobus::NAMEFilter> vtNameFilters;
+	const isobus::NAMEFilter testFilter(isobus::NAME::NAMEParameters::FunctionCode, static_cast<std::uint8_t>(isobus::NAME::Function::VirtualTerminal));
+	vtNameFilters.push_back(testFilter);
+	auto vtPartner = CANNetworkManager::CANNetwork.create_partnered_control_function(0, vtNameFilters);
+
+	DerivedTestVTClient clientUnderTest(vtPartner, internalECU);
+	auto repository = std::make_shared<TestPreferredAssignmentRepository>();
+	clientUnderTest.set_auxiliary_preferred_assignment_repository(repository);
+
+	const std::uint64_t vtName = vtPartner->get_NAME().get_full_name();
+	const std::uint16_t modelId = 0x55;
+	const std::uint64_t inputDeviceName = 0x0102030405060708ULL;
+	repository->recordsByVT[vtName].push_back({ inputDeviceName,
+	                                            modelId,
+	                                            { 0x1001,
+	                                              0x2001,
+	                                              VirtualTerminalClient::AuxiliaryTypeTwoFunctionType::BooleanLatching } });
+	clientUnderTest.test_wrapper_merge_persisted_preferred_assignments();
+
+	const std::uint16_t preferredFunctionObjectID = 0x1002;
+	const std::uint16_t preferredInputObjectID = 0x2002;
+	const std::uint8_t preferredFunctionType = static_cast<std::uint8_t>(VirtualTerminalClient::AuxiliaryTypeTwoFunctionType::BooleanLatching);
+
+	const CANMessage preferredAssignMessage = create_vt_to_ecu_message(vtPartner,
+	                                                                   internalECU,
+	                                                                   { static_cast<std::uint8_t>(VirtualTerminalClient::Function::AuxiliaryAssignmentTypeTwoCommand),
+	                                                                     static_cast<std::uint8_t>(inputDeviceName),
+	                                                                     static_cast<std::uint8_t>(inputDeviceName >> 8),
+	                                                                     static_cast<std::uint8_t>(inputDeviceName >> 16),
+	                                                                     static_cast<std::uint8_t>(inputDeviceName >> 24),
+	                                                                     static_cast<std::uint8_t>(inputDeviceName >> 32),
+	                                                                     static_cast<std::uint8_t>(inputDeviceName >> 40),
+	                                                                     static_cast<std::uint8_t>(inputDeviceName >> 48),
+	                                                                     static_cast<std::uint8_t>(inputDeviceName >> 56),
+	                                                                     static_cast<std::uint8_t>(0x80 | preferredFunctionType),
+	                                                                     static_cast<std::uint8_t>(preferredInputObjectID),
+	                                                                     static_cast<std::uint8_t>(preferredInputObjectID >> 8),
+	                                                                     static_cast<std::uint8_t>(preferredFunctionObjectID),
+	                                                                     static_cast<std::uint8_t>(preferredFunctionObjectID >> 8) });
+	clientUnderTest.test_wrapper_process_rx_message(preferredAssignMessage, &clientUnderTest);
+
+	EXPECT_EQ(static_cast<std::size_t>(1), repository->storeCalls);
+	EXPECT_EQ(preferredFunctionObjectID, repository->lastStored.function.functionObjectID);
+	EXPECT_EQ(preferredInputObjectID, repository->lastStored.function.inputObjectID);
+
+	const std::uint16_t nonPreferredFunctionObjectID = 0x1003;
+	const CANMessage nonPreferredAssignMessage = create_vt_to_ecu_message(vtPartner,
+	                                                                      internalECU,
+	                                                                      { static_cast<std::uint8_t>(VirtualTerminalClient::Function::AuxiliaryAssignmentTypeTwoCommand),
+	                                                                        static_cast<std::uint8_t>(inputDeviceName),
+	                                                                        static_cast<std::uint8_t>(inputDeviceName >> 8),
+	                                                                        static_cast<std::uint8_t>(inputDeviceName >> 16),
+	                                                                        static_cast<std::uint8_t>(inputDeviceName >> 24),
+	                                                                        static_cast<std::uint8_t>(inputDeviceName >> 32),
+	                                                                        static_cast<std::uint8_t>(inputDeviceName >> 40),
+	                                                                        static_cast<std::uint8_t>(inputDeviceName >> 48),
+	                                                                        static_cast<std::uint8_t>(inputDeviceName >> 56),
+	                                                                        preferredFunctionType,
+	                                                                        static_cast<std::uint8_t>(preferredInputObjectID),
+	                                                                        static_cast<std::uint8_t>(preferredInputObjectID >> 8),
+	                                                                        static_cast<std::uint8_t>(nonPreferredFunctionObjectID),
+	                                                                        static_cast<std::uint8_t>(nonPreferredFunctionObjectID >> 8) });
+	clientUnderTest.test_wrapper_process_rx_message(nonPreferredAssignMessage, &clientUnderTest);
+
+	EXPECT_EQ(static_cast<std::size_t>(1), repository->storeCalls);
+
+	clientUnderTest.test_wrapper_remove_persisted_preferred_assignment(preferredFunctionObjectID);
+	EXPECT_EQ(static_cast<std::size_t>(1), repository->removeCalls);
+	EXPECT_EQ(preferredFunctionObjectID, repository->lastRemovedFunctionObjectID);
+
+	CANNetworkManager::CANNetwork.deactivate_control_function(vtPartner);
+	CANNetworkManager::CANNetwork.deactivate_control_function(internalECU);
+}

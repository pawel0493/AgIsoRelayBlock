+	void VirtualTerminalClient::merge_persisted_preferred_assignments_into_runtime_state()
+	{
+		const auto preferredAssignments = load_preferred_auxiliary_assignments_for_active_vt();
+
+		for (const auto &storedAssignment : preferredAssignments)
+		{
+			auto inputDevice = std::find_if(assignedAuxiliaryInputDevices.begin(), assignedAuxiliaryInputDevices.end(), [&storedAssignment](const AssignedAuxiliaryInputDevice &aux) {
+				return aux.name == storedAssignment.auxiliaryInputDeviceName;
+			});
+
+			if (inputDevice == assignedAuxiliaryInputDevices.end())
+			{
+				assignedAuxiliaryInputDevices.push_back({ storedAssignment.auxiliaryInputDeviceName, storedAssignment.modelIdentificationCode, {} });
+				inputDevice = assignedAuxiliaryInputDevices.end() - 1;
+			}
+
+			auto existingAssignment = std::find(inputDevice->functions.begin(), inputDevice->functions.end(), storedAssignment.function);
+			if (existingAssignment == inputDevice->functions.end())
+			{
+				inputDevice->functions.push_back(storedAssignment.function);
+			}
+		}
+	}
+
+	void VirtualTerminalClient::persist_preferred_assignment(const PreferredAuxiliaryAssignment &assignment)
+	{
+		if ((nullptr == preferredAuxiliaryAssignmentRepository) ||
+		    (nullptr == partnerControlFunction))
+		{
+			return;
+		}
+
+		preferredAuxiliaryAssignmentRepository->store(partnerControlFunction->get_NAME().get_full_name(), assignment);
+	}
+
+	void VirtualTerminalClient::remove_persisted_preferred_assignment(std::uint16_t functionObjectID)
+	{
+		if ((nullptr == preferredAuxiliaryAssignmentRepository) ||
+		    (nullptr == partnerControlFunction))
+		{
+			return;
+		}
+
+		preferredAuxiliaryAssignmentRepository->remove(partnerControlFunction->get_NAME().get_full_name(), functionObjectID);
+	}
+
+	void VirtualTerminalClient::clear_persisted_preferred_assignments()
+	{
+		if ((nullptr == preferredAuxiliaryAssignmentRepository) ||
+		    (nullptr == partnerControlFunction))
+		{
+			return;
+		}
+
+		preferredAuxiliaryAssignmentRepository->clear(partnerControlFunction->get_NAME().get_full_name());

+TEST_F(VirtualTerminalTest, PreferredAuxAssignmentsStoreAllMode)
+{
+	NAME clientNAME(0);
+	auto internalECU = CANNetworkManager::CANNetwork.create_internal_control_function(clientNAME, 0, 0x26);
+
+	std::vector<isobus::NAMEFilter> vtNameFilters;
+	const isobus::NAMEFilter testFilter(isobus::NAME::NAMEParameters::FunctionCode, static_cast<std::uint8_t>(isobus::NAME::Function::VirtualTerminal));
+	vtNameFilters.push_back(testFilter);
+	auto vtPartner = CANNetworkManager::CANNetwork.create_partnered_control_function(0, vtNameFilters);
+
+	DerivedTestVTClient clientUnderTest(vtPartner, internalECU);
+	auto repository = std::make_shared<TestPreferredAssignmentRepository>();
+	clientUnderTest.set_auxiliary_preferred_assignment_repository(repository);
+	clientUnderTest.set_auxiliary_store_all_assignments(true);
+
+	const std::uint64_t inputDeviceName = 0x0102030405060708ULL;
+	repository->recordsByVT[vtPartner->get_NAME().get_full_name()].push_back({ inputDeviceName,
+	                                                                          0x55,
+	                                                                          { 0x1001,
+	                                                                            0x2001,
+	                                                                            VirtualTerminalClient::AuxiliaryTypeTwoFunctionType::BooleanLatching } });
+	clientUnderTest.test_wrapper_merge_persisted_preferred_assignments();
+
+	auto make_assign = [&](std::uint16_t input, std::uint16_t function) {
+		return create_vt_to_ecu_message(vtPartner,
+		                                internalECU,
+		                                { static_cast<std::uint8_t>(VirtualTerminalClient::Function::AuxiliaryAssignmentTypeTwoCommand),
+		                                  static_cast<std::uint8_t>(inputDeviceName),
+		                                  static_cast<std::uint8_t>(inputDeviceName >> 8),
+		                                  static_cast<std::uint8_t>(inputDeviceName >> 16),
+		                                  static_cast<std::uint8_t>(inputDeviceName >> 24),
+		                                  static_cast<std::uint8_t>(inputDeviceName >> 32),
+		                                  static_cast<std::uint8_t>(inputDeviceName >> 40),
+		                                  static_cast<std::uint8_t>(inputDeviceName >> 48),
+		                                  static_cast<std::uint8_t>(inputDeviceName >> 56),
+		                                  static_cast<std::uint8_t>(VirtualTerminalClient::AuxiliaryTypeTwoFunctionType::BooleanLatching), // storeAsPreferred NOT set
+		                                  static_cast<std::uint8_t>(input),
+		                                  static_cast<std::uint8_t>(input >> 8),
+		                                  static_cast<std::uint8_t>(function),
+		                                  static_cast<std::uint8_t>(function >> 8) });
+	};
+
+	clientUnderTest.test_wrapper_process_rx_message(make_assign(0x2002, 0x1002), &clientUnderTest);
+	EXPECT_EQ(static_cast<std::size_t>(1), repository->storeCalls);
+	EXPECT_EQ(static_cast<std::uint16_t>(0x1002), repository->lastStored.function.functionObjectID);
+
+	// Unassign (NULL input, NAME = default, type 0x1F) removes the entry even without storeAsPreferred
+	const std::uint64_t defaultName = 0xFFFFFFFFFFFFFFFFULL;
+	const CANMessage unassign = create_vt_to_ecu_message(vtPartner,
+	                                                     internalECU,
+	                                                     { static_cast<std::uint8_t>(VirtualTerminalClient::Function::AuxiliaryAssignmentTypeTwoCommand),
+	                                                       static_cast<std::uint8_t>(defaultName),
+	                                                       static_cast<std::uint8_t>(defaultName >> 8),
+	                                                       static_cast<std::uint8_t>(defaultName >> 16),
+	                                                       static_cast<std::uint8_t>(defaultName >> 24),
+	                                                       static_cast<std::uint8_t>(defaultName >> 32),
+	                                                       static_cast<std::uint8_t>(defaultName >> 40),
+	                                                       static_cast<std::uint8_t>(defaultName >> 48),
+	                                                       static_cast<std::uint8_t>(defaultName >> 56),
+	                                                       0x1F,
+	                                                       0xFF,
+	                                                       0xFF,
+	                                                       0x02,
+	                                                       0x10 });
+	clientUnderTest.test_wrapper_process_rx_message(unassign, &clientUnderTest);
+	EXPECT_EQ(static_cast<std::size_t>(1), repository->removeCalls);
+	EXPECT_EQ(static_cast<std::uint16_t>(0x1002), repository->lastRemovedFunctionObjectID);
+
+	CANNetworkManager::CANNetwork.deactivate_control_function(vtPartner);
+	CANNetworkManager::CANNetwork.deactivate_control_function(internalECU);
+}

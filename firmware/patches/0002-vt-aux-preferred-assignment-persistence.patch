+class TestPreferredAssignmentRepository : public VirtualTerminalClient::AuxiliaryPreferredAssignmentRepository
+{
+public:
+	std::map<std::uint64_t, std::vector<VirtualTerminalClient::PreferredAuxiliaryAssignment>> recordsByVT;
+	std::size_t storeCalls = 0;
+	std::size_t removeCalls = 0;
+	std::size_t clearCalls = 0;
+	VirtualTerminalClient::PreferredAuxiliaryAssignment lastStored{ };
+	std::uint16_t lastRemovedFunctionObjectID = 0;
+
+	std::vector<VirtualTerminalClient::PreferredAuxiliaryAssignment> load(std::uint64_t virtualTerminalName) override
+	{
+		auto result = recordsByVT.find(virtualTerminalName);
+		if (result == recordsByVT.end())
+		{
+			return {};
+		}
+		return result->second;
+	}
+
+	bool store(std::uint64_t virtualTerminalName, const VirtualTerminalClient::PreferredAuxiliaryAssignment &assignment) override
+	{
+		++storeCalls;
+		lastStored = assignment;
+		auto &records = recordsByVT[virtualTerminalName];
+		auto existing = std::find_if(records.begin(), records.end(), [&assignment](const VirtualTerminalClient::PreferredAuxiliaryAssignment &item) {
+			return item.function.functionObjectID == assignment.function.functionObjectID;
+		});
+		if (existing != records.end())
+		{
+			*existing = assignment;
+		}
+		else
+		{
+			records.push_back(assignment);
+		}
+		return true;
+	}
+
+	bool remove(std::uint64_t virtualTerminalName, std::uint16_t functionObjectID) override
+	{
+		++removeCalls;
+		lastRemovedFunctionObjectID = functionObjectID;
+		auto &records = recordsByVT[virtualTerminalName];
+		records.erase(std::remove_if(records.begin(), records.end(), [functionObjectID](const VirtualTerminalClient::PreferredAuxiliaryAssignment &item) {
+			return item.function.functionObjectID == functionObjectID;
+		}),
+		              records.end());
+		return true;
+	}
+
+	bool clear(std::uint64_t virtualTerminalName) override
+	{
+		++clearCalls;
+		recordsByVT.erase(virtualTerminalName);
+		return true;
+	}
 };
 

+TEST_F(VirtualTerminalTest, PreferredAssignmentMessageFormat)
+{
+	// No assignments: function code, zero units, padded with 0xFF to 8 bytes
+	auto empty = DerivedTestVTClient::test_wrapper_build_preferred_assignment_message({});
+	ASSERT_EQ(static_cast<std::size_t>(8), empty.size());
+	EXPECT_EQ(0x22, empty[0]);
+	EXPECT_EQ(0, empty[1]);
+	EXPECT_EQ(0xFF, empty[2]);
+
+	const std::uint64_t deviceA = 0x0102030405060708ULL;
+	const std::uint64_t deviceB = 0x1112131415161718ULL;
+	std::vector<VirtualTerminalClient::PreferredAuxiliaryAssignment> assignments = {
+		{ deviceA, 0x0A0B, { 0x1001, 0x2001, VirtualTerminalClient::AuxiliaryTypeTwoFunctionType::BooleanLatching } },
+		{ deviceB, 0x0C0D, { 0x1003, 0x2003, VirtualTerminalClient::AuxiliaryTypeTwoFunctionType::BooleanLatching } },
+		{ deviceA, 0x0A0B, { 0x1002, 0x2002, VirtualTerminalClient::AuxiliaryTypeTwoFunctionType::BooleanLatching } }
+	};
+	auto message = DerivedTestVTClient::test_wrapper_build_preferred_assignment_message(assignments);
+
+	// 2 header + (8 NAME + 2 model + 1 count + 2 * 4) + (8 + 2 + 1 + 4)
+	ASSERT_EQ(static_cast<std::size_t>(2 + 19 + 15), message.size());
+	EXPECT_EQ(0x22, message[0]);
+	EXPECT_EQ(2, message[1]); // Two input units
+	EXPECT_EQ(0x08, message[2]); // Device A NAME, little endian
+	EXPECT_EQ(0x01, message[9]);
+	EXPECT_EQ(0x0B, message[10]); // Model identification code, little endian
+	EXPECT_EQ(0x0A, message[11]);
+	EXPECT_EQ(2, message[12]); // Two assignments for device A
+	EXPECT_EQ(0x01, message[13]); // Function object ID 0x1001
+	EXPECT_EQ(0x10, message[14]);
+	EXPECT_EQ(0x01, message[15]); // Input object ID 0x2001
+	EXPECT_EQ(0x20, message[16]);
+	EXPECT_EQ(0x02, message[17]); // Function object ID 0x1002
+	EXPECT_EQ(0x10, message[18]);
+	EXPECT_EQ(0x18, message[21]); // Device B NAME
+	EXPECT_EQ(1, message[31]); // One assignment for device B
+}

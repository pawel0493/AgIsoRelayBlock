+	std::vector<std::uint8_t> VirtualTerminalClient::build_preferred_assignment_message(const std::vector<PreferredAuxiliaryAssignment> &assignments)
+	{
+		// Group by input unit (NAME + model identification code), keeping first-seen order
+		std::vector<std::pair<std::pair<std::uint64_t, std::uint16_t>, std::vector<const PreferredAuxiliaryAssignment *>>> units;
+		for (const auto &assignment : assignments)
+		{
+			const auto key = std::make_pair(assignment.auxiliaryInputDeviceName, assignment.modelIdentificationCode);
+			auto unit = std::find_if(units.begin(), units.end(), [&key](const decltype(units)::value_type &item) {
+				return item.first == key;
+			});
+			if (unit == units.end())
+			{
+				units.push_back({ key, {} });
+				unit = units.end() - 1;
+			}
+			if (unit->second.size() < 255)
+			{
+				unit->second.push_back(&assignment);
+			}
+		}
+		if (units.size() > 255)
+		{
+			units.resize(255);
+		}
+
+		std::vector<std::uint8_t> buffer = { static_cast<std::uint8_t>(Function::PreferredAssignmentCommand),
+			                                 static_cast<std::uint8_t>(units.size()) };
+		for (const auto &unit : units)
+		{
+			for (std::uint8_t shift = 0; shift < 64; shift += 8)
+			{
+				buffer.push_back(static_cast<std::uint8_t>(unit.first.first >> shift));
+			}
+			buffer.push_back(static_cast<std::uint8_t>(unit.first.second));
+			buffer.push_back(static_cast<std::uint8_t>(unit.first.second >> 8));
+			buffer.push_back(static_cast<std::uint8_t>(unit.second.size()));
+			for (const auto *assignment : unit.second)
+			{
+				buffer.push_back(static_cast<std::uint8_t>(assignment->function.functionObjectID));
+				buffer.push_back(static_cast<std::uint8_t>(assignment->function.functionObjectID >> 8));
+				buffer.push_back(static_cast<std::uint8_t>(assignment->function.inputObjectID));
+				buffer.push_back(static_cast<std::uint8_t>(assignment->function.inputObjectID >> 8));
+			}
+		}
 		if (buffer.size() < CAN_DATA_LENGTH)
 		{
-			buffer.resize(CAN_DATA_LENGTH);
+			buffer.resize(CAN_DATA_LENGTH, 0xFF);
+		}
+		return buffer;
+	}
